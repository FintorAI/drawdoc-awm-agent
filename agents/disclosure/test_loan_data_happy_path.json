  "_comment_agent_workflow": "=== AGENT WORKFLOW ===",
  "agent_workflow": {
    "step_0_pre_check": {
      "checks": [
        "Milestone status",
        "Disclosure tracking (LE already sent?)",
        "Loan eligibility"
      ],
      "blocking": "If LE already sent, loan in terminal status"
    },
    "step_1_verification": {
      "checks": [
        "MVP eligibility (1172, 14, 19)",
        "TRID compliance (745, 3152, 748)",
        "Hard stops (FE0117, 1240)",
        "Form validation (47+ fields)",
        "Lock status (761, 762, 2400)"
      ],
      "blocking": "Hard stops, LE due date passed, closing < 15 days"
    },
    "step_2_preparation": {
      "updates": [
        "RegZ-LE fields (LE1.X1, 672, 673, 3517, etc.)",
        "MI calculation (if LTV > 80%)",
        "CTC matching (NEWHUD2.X55-X58)"
      ],
      "blocking": "None - warnings only"
    },
    "step_3_send": {
      "checks": [
        "Mavent compliance",
        "ATR/QM flags (ATRQM.X1-X3)",
        "Audit loan"
      ],
      "actions": [
        "Order disclosure package via eDisclosures API"
      ],
      "blocking": "Mavent issues, ATR/QM red flags"
    }
  }
}
